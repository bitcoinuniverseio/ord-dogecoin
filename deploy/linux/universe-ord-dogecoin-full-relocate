#!/bin/bash
# Relocate the Dogecoin full ord index build (drc20/dunes/transactions) from
# universe-indexers-1 to universe-indexers-1-new (OVH). Gated on the destination
# SMART long tests, then: hot rsync, brief stop of the source service, delta
# rsync, restart source (keeps serving 8391), start destination builder.
set -euo pipefail
LOG=/var/log/universe-indexers1-migration/ord-dogecoin-full-relocate.log
exec >>"$LOG" 2>&1
RSH="ssh -i /root/.ssh/universe-indexers-1-to-new -o IdentitiesOnly=yes -o BatchMode=yes"
D=ubuntu@51.222.43.129
SRC=/data/indexers-c/ord-dogecoin-full/index-all.redb
DST=/data/indexers/data/indexers-c/ord-dogecoin-full/index-all.redb
log(){ printf '%s %s\n' "$(date -Is)" "$*"; }
# Gate on the data disk (sdb3 = /data/indexers). The extended self-test on these
# 65k-hour drives sits at "10% remaining" for hours (host IO suspends it); accept
# the gate once sdb has reported 10% remaining for more than an hour with zero
# reallocated/pending/uncorrectable sectors and an overall PASSED health.
# IMPLEMENTATION-HANDOFF [WP07] BEGIN
# Repair relocation health gate before resuming migration
# Coverage: OPS-RELOCATION, OPS-RECOVERY; defects: D06; functional status: FAIL.
# Observed: smart_done returns success when 'Self-test routine in progress' is absent without checking completed test result. Its grep for IDs 5/197/198 succeeds when any matching zero row exists, not all three. Therefore failed/missing tests or nonzero attributes can satisfy the gate. Current interruption cause remains unresolved.
# Sources: S-ORD (research-register.json in the server handoff).
# Prerequisites: none.
# 1. Replace text-pattern early return with structured smartctl JSON parsing in the owning relocation script. Require a successful completed extended self-test and explicit overall health plus all selected device-applicable error counters; reject missing/unparseable data. Do not treat one zero row as proof all counters are zero.
# 2. Tie result to the destination disk serial and test start/completion time; a previous short test is insufficient. Remove the elapsed-at-10-percent success shortcut unless a separately reviewed storage policy supplies equivalent verified protection.
# 3. Add shell/script tests with saved sanitized smartctl fixtures: failed completed test, absent extended test, one nonzero selected counter, missing field, in-progress, clean completed test. Validate script syntax and cleanup/traps without production copy or service changes.
# 4. Review interruption/resume state, destination lock/checkpoint and copy consistency. Coordinate with the existing operator workflow; retain the current serving index and do not interrupt active reorg/indexing. Never resume by assuming partial copied redb is sound.
# Verification: Proposed new deploy/linux/tests/relocate-smart-gate fixtures and test harness; bash -n deploy/linux/universe-ord-dogecoin-full-relocate. Commands not executed; production state untouched.
# Acceptance: Only verified healthy destination and consistent snapshot pass; all unsafe/missing cases fail closed; interruption preserves source service and resumable evidence.
# Rollback: Keep previous source index untouched. If destination validation fails, leave it unserved and retain original routing. Do not weaken health gates to accelerate launch.
# IMPLEMENTATION-HANDOFF [WP07] END
smart_done(){
  local st; st=$($RSH $D 'sudo -n smartctl -a /dev/sdb')
  grep -q "Self-test routine in progress" <<<"$st" || return 0
  grep -q "10% of test remaining" <<<"$st" || return 1
  grep -qE "^ *(5|197|198) .* 0$" <<<"$st" || return 1
  grep -q "PASSED" <<<"$st" || return 1
  local stamp=/var/lib/universe-ord-dogecoin-full-relocate.sdb-10pct-since
  [ -f "$stamp" ] || date +%s > "$stamp"
  [ $(( $(date +%s) - $(cat "$stamp") )) -gt 3600 ] || return 1
  log "accepting the SMART gate: sdb at 10% remaining for over an hour, no reallocated/pending/uncorrectable sectors, health PASSED"
}
log "start"
while ! smart_done; do log "waiting: destination SMART long tests still running"; sleep 600; done
log "SMART tests finished; results:"
$RSH $D 'for d in sda sdb; do sudo -n smartctl -l selftest /dev/$d | sed -n 1,8p; done' || true
if $RSH $D 'for d in sda sdb; do sudo -n smartctl -l selftest /dev/$d | sed -n 1,8p | grep -qi "failure" && exit 0; done; exit 1'; then
  log "ABORT: destination SMART self-test reported failure"; exit 1
fi
log "hot copy"
ionice -c3 nice -n 19 rsync -a --inplace --partial --bwlimit=60m --info=progress2,stats2 -e "$RSH" --rsync-path="sudo rsync" "$SRC" "$D:$DST"
log "hot copy done; stopping source builder for consistent delta"
systemctl stop universe-ord-dogecoin-full.service
trap 'systemctl start universe-ord-dogecoin-full.service' EXIT
sha=$(sha256sum "$SRC" | cut -d" " -f1); log "source sha256=$sha size=$(stat -c %s "$SRC")"
ionice -c3 nice -n 19 rsync -a --inplace --partial --bwlimit=120m --info=progress2,stats2 -e "$RSH" --rsync-path="sudo rsync" "$SRC" "$D:$DST"
dsha=$($RSH $D "sudo -n sha256sum $DST | cut -d' ' -f1"); log "dest sha256=$dsha"
[ "$sha" = "$dsha" ] || { log "ABORT: checksum mismatch"; exit 1; }
systemctl start universe-ord-dogecoin-full.service; trap - EXIT
log "source restarted (serving 8391 at stale height until destination reaches tip)"
$RSH $D "sudo -n chown universe-ord-dogecoin:universe-ord-dogecoin $DST; sudo -n chmod 640 $DST; sudo -n systemctl start universe-ord-dogecoin-full.service; sleep 30; sudo -n journalctl -u universe-ord-dogecoin-full -n 5 -o cat"
log "destination builder started"
